# Configure these as runtime environment values in Sites.
# Optional locally: copy to .dev.vars for the Cloudflare dev server.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Enable only after SMTP, redirect URLs and real email flows are verified.
SUPABASE_AUTH_EMAIL_READY=false
# Admin-copyable invitation/recovery links (server-only; separate activation required).
# Never use a NEXT_PUBLIC_ prefix for this secret.
SUPABASE_SECRET_KEY=
# Explicitly approved, verified account-admin emails, comma-separated.
ACCOUNT_ADMIN_EMAILS=
